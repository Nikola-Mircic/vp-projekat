<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
	<appSettings>
		<add key="BatteryLowThreshold" value="91"/>
		<add key="ContactQualityMin" value="100"/>
		<add key="StressSpikeThreshold" value="0.002"/>
		<add key="RelaxationDropThreshold" value="0.002"/>
		<add key="TimestampSkewMaxMs" value="1000"/>
	</appSettings>
	<system.serviceModel>
		<services>
			<service name="Server.Server">
				<host>
					<baseAddresses>
						<add baseAddress="net.tcp://localhost:4000"/>
					</baseAddresses>
				</host>
				<endpoint 
					address="/" 
					binding="netTcpBinding" 
					contract="Common.IServer"/>
			</service>
		</services>
	</system.serviceModel>
</configuration>